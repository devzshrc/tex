# ------------------------------------------------------------------
# Backend API (Express on Bun)
# Copy to `.env` and fill in the blanks.
# Google credentials: Google Cloud Console → APIs & Services → Credentials
#   → Create Credentials → OAuth client ID (Web application).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# ------------------------------------------------------------------

PORT=8000

# Public base URL of THIS backend. Better Auth builds the OAuth
# redirect_uri from it — it must match the URI registered in Google.
BETTER_AUTH_URL=http://localhost:8000
# Generate with: openssl rand -base64 32  (min 32 chars, high entropy)
BETTER_AUTH_SECRET=

# Where the React app is served from (CORS + trustedOrigins).
FRONTEND_URL=http://localhost:3000

# Postgres (docker-compose.yml in this folder reads this same file).
# Keep DATABASE_URL in sync with POSTGRES_* below.
DATABASE_URL=postgresql://auth:auth@localhost:5433/authdb
POSTGRES_USER=auth
POSTGRES_PASSWORD=auth
POSTGRES_DB=authdb
# Host port (another local project already uses 5432).
POSTGRES_PORT=5433

# Local attachment storage (10 MB/file cap, see src/common/storage.ts).
UPLOAD_DIR=./uploads

# Google OAuth credentials (required for sign-in to work).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
