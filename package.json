{
  "name": "tex",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "check": "turbo run typecheck build",
    "db:up": "bun run --cwd apps/api db:up",
    "db:down": "bun run --cwd apps/api db:down",
    "db:logs": "bun run --cwd apps/api db:logs",
    "db:reset": "bun run --cwd apps/api db:reset",
    "db:setup": "bun run --cwd apps/api db:setup",
    "db:generate": "bun run --cwd apps/api db:generate",
    "db:migrate": "bun run --cwd apps/api db:migrate",
    "db:push": "bun run --cwd apps/api db:push",
    "db:studio": "bun run --cwd apps/api db:studio",
    "auth:schema": "bun run --cwd apps/api auth:schema",
    "verify:trello": "bun run --cwd apps/api verify:trello",
    "cf:deploy:api": "bun run --cwd apps/api cf:deploy",
    "cf:deploy:web": "bun run --cwd apps/web cf:deploy"
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "^7.0.2",
    "wrangler": "^4.34.0"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
