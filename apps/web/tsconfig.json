{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun", "react"],

    "paths": {
      "@/*": ["./src/*"]
    }
  },

  "exclude": ["dist", "node_modules"]
}
